# Railway-specific environment template for the plate-runner-server service.
# See docs/RAILWAY_DEPLOYMENT_PLAN.md for the full deployment walkthrough.
# NO REAL SECRETS BELOW.

PLATE_RUNNER_ENV=production

# Generate with: openssl rand -hex 32 — set this in the Railway service's
# Variables tab, never commit the real value.
PLATE_RUNNER_API_KEY=REPLACE_WITH_A_GENERATED_32+_CHAR_SECRET

# The web service's public Railway URL (and/or custom domain), comma-separated
# if you have more than one (e.g. a Railway-generated domain + a custom one).
PLATE_RUNNER_CORS_ORIGINS=https://plate-runner-web-production.up.railway.app

# Do NOT set PORT yourself — Railway injects it automatically and this app
# reads it first (falls back to PLATE_RUNNER_SERVER_PORT, then 8787, only if
# PORT is absent, e.g. running locally).

# Must be the mount path of a Railway Volume attached to this service —
# without one, SQLite data is lost on every redeploy/restart. See
# docs/RAILWAY_DEPLOYMENT_PLAN.md's Storage section.
PLATE_RUNNER_STORAGE_PATH=/data

# Recommended for a public deployment — 30-90 days is a reasonable range.
PLATE_RUNNER_PAIRING_TOKEN_TTL_DAYS=30

# Optional — defaults are usually fine to start with.
# PLATE_RUNNER_BODY_LIMIT_BYTES=1000000
# PLATE_RUNNER_RATE_LIMIT_GENERAL_PER_MIN=100
# PLATE_RUNNER_RATE_LIMIT_REMOTE_PER_MIN=30
# PLATE_RUNNER_RATE_LIMIT_PAIRING_PER_MIN=10

# --- plate-runner-web service (separate service, build-time only) ---
# This app's frontend takes its backend URL from the in-app Settings screen
# at runtime, not a VITE_* build-time env var — no frontend env vars are
# required for a basic deploy. See docs/RAILWAY_DEPLOYMENT_PLAN.md if you
# want to bake in a default API Base URL instead of leaving it operator-set.
