# Production environment template — copy to .env and fill in real values.
# NO REAL SECRETS BELOW. See docs/SECURITY_AUDIT_RAILWAY_READINESS.md and
# docs/RAILWAY_DEPLOYMENT_PLAN.md before deploying with these settings.

# Required — enables hard startup validation (missing/weak API key or
# missing CORS origins will abort startup instead of falling back to an
# insecure default). Does NOT need to match NODE_ENV.
PLATE_RUNNER_ENV=production

# Required. Generate with: openssl rand -hex 32
# Must be >= 32 characters and must NOT be "dev-local-key" — startup fails
# otherwise when PLATE_RUNNER_ENV=production.
PLATE_RUNNER_API_KEY=REPLACE_WITH_A_GENERATED_32+_CHAR_SECRET

# Required. Comma-separated, no wildcard, no trailing slash. Exactly the
# origin(s) your frontend is actually served from.
PLATE_RUNNER_CORS_ORIGINS=https://your-frontend-domain.example

# Server listen port. Most PaaS providers (including Railway) inject PORT
# automatically — this app reads PORT first, PLATE_RUNNER_SERVER_PORT second.
PORT=8787

# Must point at a persistent volume — an ephemeral filesystem will lose all
# data (displays, pairings, execution history) on every restart/redeploy.
PLATE_RUNNER_STORAGE_PATH=/data

# Optional hardening — recommended for a production/public deployment.
# Empty/unset = controller tokens never expire (documented default).
PLATE_RUNNER_PAIRING_TOKEN_TTL_DAYS=30

# Optional — defaults shown; tune down for a public deployment if desired.
PLATE_RUNNER_BODY_LIMIT_BYTES=1000000
PLATE_RUNNER_RATE_LIMIT_GENERAL_PER_MIN=100
PLATE_RUNNER_RATE_LIMIT_REMOTE_PER_MIN=30
PLATE_RUNNER_RATE_LIMIT_PAIRING_PER_MIN=10
