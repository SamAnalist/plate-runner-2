# Local development defaults — safe to leave blank/unset. See
# docs/OPERATIONS_GUIDE.md for the full reference, and
# .env.production.example / .env.railway.example for a production deploy.

PLATE_RUNNER_ENV=development
PLATE_RUNNER_API_KEY=
PLATE_RUNNER_SERVER_PORT=8787
PLATE_RUNNER_STORAGE_PATH=./data
PLATE_RUNNER_CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Optional — all have safe defaults, uncomment to override locally.
# PLATE_RUNNER_BODY_LIMIT_BYTES=1000000
# PLATE_RUNNER_PAIRING_TOKEN_TTL_DAYS=
# PLATE_RUNNER_RATE_LIMIT_GENERAL_PER_MIN=100
# PLATE_RUNNER_RATE_LIMIT_REMOTE_PER_MIN=30
# PLATE_RUNNER_RATE_LIMIT_PAIRING_PER_MIN=10

# For real LAN testing (two computers — see docs/MANUAL_TESTING_GUIDE.md's
# "Real LAN Testing: Two Computers" section), add the LAN-facing origin(s)
# the frontend will actually be opened from, e.g.:
# PLATE_RUNNER_CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://192.168.1.50:5173,http://192.168.1.50:8080
